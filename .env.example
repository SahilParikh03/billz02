# BILLZ — environment template. Copy to .env.local and fill in.
# In MOCK mode the app runs fully offline (no wallet, no network) so you can
# exercise routing, streaming, the $5 session budget, and the live spend feed.

# "mock" (default, offline) | "live" (real x402 calls to Venice + Hyperbolic)
BILLZ_PROVIDER_MODE=mock

# Per-session spend cap in USD. Stage 0 hard-codes $5.
BILLZ_SESSION_BUDGET_USD=5

# Max a single x402 call may settle, in USD (maps to x402-fetch maxValue).
BILLZ_MAX_PAYMENT_PER_CALL_USD=0.10

# "base-sepolia" (testnet) | "base" (mainnet)
BILLZ_NETWORK=base-sepolia

# Public facilitator for first wiring; swap for CDP facilitator at mainnet.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Router hot wallet private key (0x-prefixed). Generate locally; treat as a secret.
# In live mode this wallet pays providers. Fund on testnet via faucet.circle.com.
WALLET_PRIVATE_KEY=

# Provider endpoints
VENICE_BASE_URL=https://api.venice.ai/api/v1
HYPERBOLIC_X402_URL=https://hyperbolic-x402.vercel.app/v1/chat/completions

# Venice API key (optional — Stage 0 convenience path).
# If set, sent as a Bearer token for Venice inference requests.
# PRODUCTION path: x402 credit-balance top-up + X-Sign-In-With-X SIWE header (TODO Stage 1).
# Get a key at venice.ai, or leave blank and fund the wallet for the x402 path.
VENICE_API_KEY=

# ── Stage 1: routing + semantic cache ─────────────────────────────────────────
# Difficulty ≥ threshold routes to the strong tier; below it, the cheap tier.
BILLZ_DIFFICULTY_THRESHOLD=0.5
# Optional score weights (0 = ignore). λ on latency, μ on (1 − qualityPrior).
BILLZ_LATENCY_WEIGHT=0
BILLZ_QUALITY_WEIGHT=0
# Semantic cache (GPTCache-style). Default on; in-memory in Stage 0/1.
BILLZ_CACHE_ENABLED=true
BILLZ_CACHE_SIM_THRESHOLD=0.83
BILLZ_CACHE_TTL_MS=86400000
BILLZ_CACHE_MAX_ENTRIES=500

# ── Stage 2: shared store, per-user budget, mainnet wallet ─────────────────────
# Per-user daily spend cap in USD (0 = disabled). Keyed by the X-Billz-User header.
BILLZ_USER_DAILY_BUDGET_USD=0

# ── Embedded wallets: email signup + welcome credit ───────────────────────────
# CDP project id for embedded-wallet email signup (public; inlined into the
# browser bundle). Get one at portal.cdp.coinbase.com → project settings, and
# add this app's origin to the project's allowed domains. UNSET → the app runs
# in anonymous (per-session) mode and the Sign-in UI shows a "not configured"
# state, so everything still builds and runs with zero setup.
NEXT_PUBLIC_CDP_PROJECT_ID=
# One-time test credit (USD) granted to a new signed-in wallet on first sign-in.
BILLZ_WELCOME_CREDIT_USD=1
# Shared store for budget state across serverless instances. If unset → in-memory.
# Upstash Redis REST (recommended for prod):
REDIS_URL=
REDIS_TOKEN=
# Wallet provider: "key" (testnet hot key, default) | "cdp" (CDP server wallet, MPC).
BILLZ_WALLET_PROVIDER=key
# Optional custom EVM RPC for mainnet (avoids public-RPC limits).
BILLZ_RPC_URL=
# Surplus Intelligence base URL (Base mainnet; verify against the live Bazaar listing).
SURPLUS_BASE_URL=https://www.surplusintelligence.ai/x402/api/inference/v1

# ── Mainnet hardening (live on Base mainnet) ──────────────────────────────────
# Checklist to flip to mainnet (verify with GET /api/readiness → liveReady:true):
#   1. BILLZ_PROVIDER_MODE=live  and  BILLZ_NETWORK=base
#   2. Fund the router wallet with mainnet USDC (0x833589fCD…02913 on Base).
#   3. Prefer CDP server wallet + CDP facilitator (set the vars below).
#   4. Set REDIS_URL/REDIS_TOKEN so budgets + cache hold across instances.
#
# CDP server wallet (BILLZ_WALLET_PROVIDER=cdp) — MPC custody, no key at rest.
# Create at portal.cdp.coinbase.com → API key (id+secret) + a wallet secret.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Named server account, reused across deploys so the same funded wallet loads.
CDP_WALLET_NAME=billz-router
#
# CDP facilitator: setting CDP_API_KEY_ID + CDP_API_KEY_SECRET (above) auto-selects
# the Coinbase-hosted facilitator (OFAC/KYT screening, 1,000 free tx/mo) over the
# public one in X402_FACILITATOR_URL. No extra var needed.
#
# Facilitator failover: comma-separated alternate facilitator URLs tried after the
# primary (e.g. xpay, OpenZeppelin Relayer). Optional.
BILLZ_FALLBACK_FACILITATORS=
