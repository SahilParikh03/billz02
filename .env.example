# BEAMR — environment template. Copy to .env.local and fill in.
# In MOCK mode the app runs fully offline (no wallet, no network) so you can
# exercise routing, streaming, the $5 session budget, and the live spend feed.

# "mock" (default, offline) | "live" (real x402 calls to Venice + Hyperbolic)
BEAMR_PROVIDER_MODE=mock

# Per-session spend cap in USD. Stage 0 hard-codes $5.
BEAMR_SESSION_BUDGET_USD=5

# Max a single x402 call may settle, in USD (maps to x402-fetch maxValue).
BEAMR_MAX_PAYMENT_PER_CALL_USD=0.10

# "base-sepolia" (testnet) | "base" (mainnet)
BEAMR_NETWORK=base-sepolia
# Public mirror of BEAMR_NETWORK for the browser wallet rail (wagmi). Inlined into
# the client bundle; sets the default chain MetaMask connects to. Match it to
# BEAMR_NETWORK. UNSET → base-sepolia.
NEXT_PUBLIC_BEAMR_NETWORK=base-sepolia

# Router hot wallet private key (0x-prefixed). Generate locally; treat as a secret.
# In live mode this wallet both pays upstream providers AND broadcasts in-process
# x402 settlement (it pays the gas; buyers pay none). Fund on testnet via
# faucet.circle.com.
WALLET_PRIVATE_KEY=
# Custom EVM RPC URL for the in-process facilitator (chain reads + settlement
# broadcast). UNSET → the viem chain's public RPC (rate-limited; set a dedicated
# RPC for prod).
BEAMR_RPC_URL=

# Provider endpoints
VENICE_BASE_URL=https://api.venice.ai/api/v1
HYPERBOLIC_X402_URL=https://hyperbolic-x402.vercel.app/v1/chat/completions

# Venice API key (optional — Stage 0 convenience path).
# If set, sent as a Bearer token for Venice inference requests.
# PRODUCTION path: x402 credit-balance top-up + X-Sign-In-With-X SIWE header (TODO Stage 1).
# Get a key at venice.ai, or leave blank and fund the wallet for the x402 path.
VENICE_API_KEY=

# Anthropic (Claude) API key (optional, live mode).
# When set, the credit-balance Anthropic provider is added to routing and exposes
# Claude Haiku 4.5 / Sonnet 4.6 / Opus 4.8 / Opus 4.7 / Fable 5. Billed against a
# pre-funded Anthropic account (not x402); the spend feed reports list price.
# Get a key at console.anthropic.com. Leave blank to keep Claude out of routing.
ANTHROPIC_API_KEY=
# Optional base-URL override (gateway/proxy). Defaults to the Anthropic API.
ANTHROPIC_BASE_URL=

# OpenRouter API key (optional, live mode) — a SECOND route to Claude.
# OpenRouter is an OpenAI-compatible aggregator that resells Claude; useful when
# you can't fund an Anthropic account directly (it accepts card AND crypto
# top-ups). When set, the credit-balance OpenRouter provider is added to routing
# and exposes Claude Haiku 4.5 / Sonnet 4.6 / Opus 4.8 / Opus 4.7 / Fable 5 under
# their OpenRouter slugs (anthropic/claude-…). Prices pass through at Anthropic
# list price; OpenRouter's fee is taken on credit top-ups, not per call.
# Get a key at openrouter.ai/keys. Leave blank to keep OpenRouter out of routing.
OPENROUTER_API_KEY=
# Optional base-URL override. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# ── Monetization: cost-plus pricing + routing policy ──────────────────────────
# Cost-plus margin. Both paid lanes charge (provider cost) × this multiplier, so
# a long Opus/Fable turn can't cost BEAMR more than it charges. 1.3 = 30% margin;
# tune against real settled costs. The x402 quote is clamped to the flat per-tier
# price (floor) and BEAMR_MAX_PAYMENT_PER_CALL_USD (cap).
BEAMR_MARGIN_MULTIPLIER=1.3
# Default routing policy: frugal (cheap-tier bias) | balanced | premium | uncensored.
# Unset → frugal, so BEAMR's own spend is minimized unless a caller opts up via
# the X-Beamr-Policy header. Set frugal explicitly in prod to make it visible.
BEAMR_POLICY_MODE=frugal

# ── Stage 1: routing + semantic cache ─────────────────────────────────────────
# Difficulty ≥ threshold routes to the strong tier; below it, the cheap tier.
BEAMR_DIFFICULTY_THRESHOLD=0.5
# Optional score weights (0 = ignore). λ on latency, μ on (1 − qualityPrior).
BEAMR_LATENCY_WEIGHT=0
BEAMR_QUALITY_WEIGHT=0
# Semantic cache (GPTCache-style). Default on; in-memory in Stage 0/1.
BEAMR_CACHE_ENABLED=true
BEAMR_CACHE_SIM_THRESHOLD=0.83
BEAMR_CACHE_TTL_MS=86400000
BEAMR_CACHE_MAX_ENTRIES=500
# Semantic-cache embedder: "local" (default, zero-dep, offline) | "minilm"
# (all-MiniLM-L6-v2 via @huggingface/transformers — higher quality, downloads
# the model on first use; run `npm install @huggingface/transformers`).
BEAMR_EMBEDDER=local
# Optional: override the MiniLM model id (default Xenova/all-MiniLM-L6-v2).
BEAMR_MINILM_MODEL=

# ── Stage 2: shared store, per-user budget, mainnet wallet ─────────────────────
# Per-user daily spend cap in USD (0 = disabled). Keyed by the X-Beamr-User header.
BEAMR_USER_DAILY_BUDGET_USD=0

# ── Top-up rails: self-custody wallet + Stripe card ───────────────────────────
# One-time test credit (USD) granted to a new signed-in identity (wallet OR email)
# on first sign-in.
BEAMR_WELCOME_CREDIT_USD=1

# Rail A — self-custody wallet (wagmi). WalletConnect project id (public; inlined
# into the browser bundle) enables the WalletConnect connector for mobile + many
# wallets. UNSET → only injected wallets (MetaMask/Rabby/Brave) are offered, which
# is enough for desktop. Get one at cloud.reown.com (formerly WalletConnect Cloud).
NEXT_PUBLIC_WALLETCONNECT_ID=

# Rail B — Stripe card top-up (server-only secrets; never exposed to the browser).
# Hosted Stripe Checkout, no publishable key needed. Get keys at dashboard.stripe.com.
#   STRIPE_SECRET_KEY      — secret API key (sk_test_… / sk_live_…)
#   STRIPE_WEBHOOK_SECRET  — signing secret for /api/credit/stripe/webhook
#                            (`stripe listen` prints it locally: whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared store for budget + credit state across serverless instances. If unset →
# in-memory. Upstash Redis REST (recommended for prod):
REDIS_URL=
REDIS_TOKEN=

# Surplus Intelligence base URL (Base mainnet; verify against the live Bazaar listing).
SURPLUS_BASE_URL=https://www.surplusintelligence.ai/x402/api/inference/v1

# ── Mainnet hardening (live on Base mainnet) ──────────────────────────────────
# Checklist to flip to mainnet (verify with GET /api/readiness → liveReady:true):
#   1. BEAMR_PROVIDER_MODE=live  and  BEAMR_NETWORK=base (+ NEXT_PUBLIC_BEAMR_NETWORK=base)
#   2. Fund the router wallet with mainnet USDC (0x833589fCD…02913 on Base) + ETH for gas.
#   3. Set BEAMR_RPC_URL to a dedicated Base RPC (avoids public-RPC limits on settlement).
#   4. Set REDIS_URL/REDIS_TOKEN so budgets + cache + webhook idempotency hold across instances.
#   5. Set STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET (live keys) for the card rail.
# Settlement is in-process (viem against USDC) — there is NO Coinbase facilitator
# or CDP server wallet any more; the router private key is the only signer.
