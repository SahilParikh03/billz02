# BILLZ — environment template. Copy to .env.local and fill in.
# In MOCK mode the app runs fully offline (no wallet, no network) so you can
# exercise routing, streaming, the $5 session budget, and the live spend feed.

# "mock" (default, offline) | "live" (real x402 calls to Venice + Hyperbolic)
BILLZ_PROVIDER_MODE=mock

# Per-session spend cap in USD. Stage 0 hard-codes $5.
BILLZ_SESSION_BUDGET_USD=5

# Max a single x402 call may settle, in USD (maps to x402-fetch maxValue).
BILLZ_MAX_PAYMENT_PER_CALL_USD=0.10

# "base-sepolia" (testnet) | "base" (mainnet)
BILLZ_NETWORK=base-sepolia

# Public facilitator for first wiring; swap for CDP facilitator at mainnet.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Router hot wallet private key (0x-prefixed). Generate locally; treat as a secret.
# In live mode this wallet pays providers. Fund on testnet via faucet.circle.com.
WALLET_PRIVATE_KEY=

# Provider endpoints
VENICE_BASE_URL=https://api.venice.ai/api/v1
HYPERBOLIC_X402_URL=https://hyperbolic-x402.vercel.app/v1/chat/completions

# Venice API key (optional — Stage 0 convenience path).
# If set, sent as a Bearer token for Venice inference requests.
# PRODUCTION path: x402 credit-balance top-up + X-Sign-In-With-X SIWE header (TODO Stage 1).
# Get a key at venice.ai, or leave blank and fund the wallet for the x402 path.
VENICE_API_KEY=

# ── Stage 1: routing + semantic cache ─────────────────────────────────────────
# Difficulty ≥ threshold routes to the strong tier; below it, the cheap tier.
BILLZ_DIFFICULTY_THRESHOLD=0.5
# Optional score weights (0 = ignore). λ on latency, μ on (1 − qualityPrior).
BILLZ_LATENCY_WEIGHT=0
BILLZ_QUALITY_WEIGHT=0
# Semantic cache (GPTCache-style). Default on; in-memory in Stage 0/1.
BILLZ_CACHE_ENABLED=true
BILLZ_CACHE_SIM_THRESHOLD=0.83
BILLZ_CACHE_TTL_MS=86400000
BILLZ_CACHE_MAX_ENTRIES=500
